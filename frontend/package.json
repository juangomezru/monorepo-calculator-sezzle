    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/node": "^22.10.2",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
